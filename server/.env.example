PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173

# Supabase (optional for flight search; required for saved/shared trip API + DB persist)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Amadeus Self-Service (server-only — never put these in VITE_*)
# Official OAuth fields: client_id = API Key, client_secret = API Secret
# Docs: https://github.com/amadeus4dev/developer-guides/blob/master/docs/quick-start.md
# Flight Offers Search: GET /v2/shopping/flight-offers
# Flight Cheapest Date Search (flexible): GET /v1/shopping/flight-dates
# Hotel List: GET /v1/reference-data/locations/hotels/by-city
# Hotel Search: GET /v3/shopping/hotel-offers
# Hotels guide: https://github.com/amadeus4dev/developer-guides/blob/master/docs/resources/hotels.md
AMADEUS_CLIENT_ID=YOUR_AMADEUS_API_KEY
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_API_SECRET
# test.api.amadeus.com (default) or api.amadeus.com
AMADEUS_HOSTNAME=test.api.amadeus.com
# Display-only FX when offers are not already KRW (usually EUR on test). Not a live FX feed.
AMADEUS_KRW_PER_EUR=1500

# Flight API tuning
FLIGHT_CACHE_TTL_MS=900000
FLIGHT_TIMEOUT_MS=12000
FLIGHT_RATE_LIMIT_PER_MINUTE=30

# Accommodation API tuning (same Amadeus credentials)
ACCOMMODATION_CACHE_TTL_MS=900000
ACCOMMODATION_TIMEOUT_MS=12000
ACCOMMODATION_RATE_LIMIT_PER_MINUTE=30
# Max hotelIds from Hotel List to price in one Hotel Search call
ACCOMMODATION_HOTEL_ID_LIMIT=5
