PORT=8787
# Comma-separated allowlist, or *. Local Vite:
CORS_ORIGIN=http://127.0.0.1:5173
# For Apps in Toss QR / live API calls from the mini-app, also allow the console
# origins for this app (SDK 3.10 uses apps / private-apps tossmini hosts — see
# https://developers-apps-in-toss.toss.im/guide/en/operation/toss ). Example:
# CORS_ORIGIN=http://127.0.0.1:5173,https://galman-hae.private-apps.tossmini.com,https://galman-hae.apps.tossmini.com
# Confirm the exact hostnames in the Apps in Toss console / current SDK docs — do not invent.

# Supabase (optional for flight search; required for saved/shared trip API + DB persist)
# Local/dev: copy this file to server/.env — the server auto-loads it when present
# (skipped when NODE_ENV=production; process env injection still wins over file values).
# Use the Dev project URL + service role only. Never put SERVICE_ROLE in VITE_*.
# Runtime requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (ANON is unused by the server).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Amadeus Self-Service (server-only — never put these in VITE_*).
# Implementation kept in tree; NOT on the normal flight/stay search path (SerpApi → Mock).
# /health still reports amadeusConfigured when both secrets are set.
# Official OAuth fields: client_id = API Key, client_secret = API Secret
# Docs: https://github.com/amadeus4dev/developer-guides/blob/master/docs/quick-start.md
AMADEUS_CLIENT_ID=YOUR_AMADEUS_API_KEY
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_API_SECRET
# test.api.amadeus.com (default) or api.amadeus.com
AMADEUS_HOSTNAME=test.api.amadeus.com
# Display-only FX when offers are not already KRW (usually EUR on test). Not a live FX feed.
AMADEUS_KRW_PER_EUR=1500

# Duffel (server-only — never put in VITE_*).
# Implementation kept in tree; NOT on the normal flight search path (SerpApi → Mock).
# /health still reports duffelConfigured when the token is set.
# Dashboard → More → Developers → Access tokens.
# Test tokens start with duffel_test_; live with duffel_live_. Do not mix test inventory with live tokens.
# https://duffel.com/docs/api/overview/making-requests
# https://duffel.com/docs/api/overview/test-mode
DUFFEL_ACCESS_TOKEN=duffel_test_YOUR_TOKEN
# Optional overrides (defaults shown)
# DUFFEL_BASE_URL=https://api.duffel.com
# DUFFEL_API_VERSION=v2
# DUFFEL_TIMEOUT_MS=12000

# SerpApi (server-only — never put in VITE_* / never VITE_SERPAPI_*).
# Default live path for Google Flights + Google Hotels. Missing key → Mock (not Duffel/Amadeus).
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=YOUR_SERPAPI_API_KEY
# Optional overrides (defaults shown)
# SERPAPI_BASE_URL=https://serpapi.com
# SERPAPI_TIMEOUT_MS=15000
# SERPAPI_GL=kr
# SERPAPI_HL=ko
# SERPAPI_CURRENCY=KRW

# Flight API tuning
FLIGHT_CACHE_TTL_MS=900000
FLIGHT_TIMEOUT_MS=12000
FLIGHT_RATE_LIMIT_PER_MINUTE=30

# Accommodation API tuning (same Amadeus credentials)
ACCOMMODATION_CACHE_TTL_MS=900000
ACCOMMODATION_TIMEOUT_MS=12000
ACCOMMODATION_RATE_LIMIT_PER_MINUTE=30
# Max hotelIds from Hotel List to price in one Hotel Search call
ACCOMMODATION_HOTEL_ID_LIMIT=5
