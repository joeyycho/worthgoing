# Frontend (Vite) — public values only. Never put SERVICE_ROLE / Amadeus secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Optional: only if you intentionally call Supabase from the browser with RLS.
# Prefer the server API for writes. Do not put the service role key in VITE_*.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ---------------------------------------------------------------------------
# Server (server/) — keep secrets out of the mini-app bundle
# Copy details into server/.env — see server/.env.example
# ---------------------------------------------------------------------------
PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Amadeus (server-only). Official names: API Key → AMADEUS_CLIENT_ID, API Secret → AMADEUS_CLIENT_SECRET
AMADEUS_CLIENT_ID=YOUR_AMADEUS_API_KEY
AMADEUS_CLIENT_SECRET=YOUR_AMADEUS_API_SECRET
AMADEUS_HOSTNAME=test.api.amadeus.com
AMADEUS_KRW_PER_EUR=1500

# Optional: direct Postgres URL for `psql` migration apply
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
