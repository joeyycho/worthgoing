{
  "name": "galman-hae",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && ait build",
    "ait:verify": "node scripts/verify-ait.mjs",
    "ait:package": "npm run build && npm run ait:verify",
    "check": "npm run lint && npm run server:typecheck && npm run ait:package",
    "smoke:server": "node scripts/smoke-server.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "ait deploy",
    "server:dev": "npm run dev --prefix server",
    "server:install": "npm install --prefix server",
    "server:typecheck": "npm run typecheck --prefix server"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@apps-in-toss/web-framework": "3.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "@apps-in-toss/devtools": "^3.10.0"
  }
}
